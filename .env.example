# Generated DB_PASSWORD is written to .env by scripts/setup.mjs.
DB_PASSWORD=GENERATE_ON_SETUP

# Each deployment uses its own Docker named volumes.
COMPOSE_PROJECT_NAME=immich-custom
IMMICH_PORT=2283
IMMICH_BIND_ADDRESS=127.0.0.1
TZ=Etc/UTC

# Optional: replace these local image names or the source-commit metadata.
# CUSTOM_SERVER_IMAGE=immich-custom-server:3.1.0
# CUSTOM_RUNNER_IMAGE=immich-custom-pair-runner:3.1.0
# CUSTOM_SOURCE_COMMIT=local
